# Get a free API key at https://resend.com — without it, the contact form
# still works but shows a "reach out directly" fallback instead of sending.
RESEND_API_KEY=

# Verified sender for the contact form. Leave blank to use Resend's shared
# onboarding@resend.dev sandbox address (only delivers to your own inbox).
CONTACT_FROM_EMAIL=

# GA4 measurement ID (G-XXXXXXXXXX). Leave blank locally — analytics only
# renders when this is set, so dev and preview traffic stays out of reports.
NEXT_PUBLIC_GA_ID=

# Canonical origin, no trailing slash. Inlined at build time — set it in the
# build environment (CI vars / Workers Builds "Build variables"). Defaults to
# the custom domain below; override only if you add a different domain.
NEXT_PUBLIC_SITE_URL=https://cosmictaser.de5.net
